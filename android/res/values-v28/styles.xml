<?xml version="1.0" encoding="utf-8"?>
<!-- Android 9 and newer: as values/styles.xml, and the game also fills the
     strip beside the camera notch when the phone is held sideways (without
     this, Android leaves that strip black). -->
<resources>
  <style name="KolamTheme" parent="@android:style/Theme.NoTitleBar.Fullscreen">
    <item name="android:windowTranslucentStatus">true</item>
    <item name="android:windowTranslucentNavigation">true</item>
    <item name="android:windowLayoutInDisplayCutoutMode">shortEdges</item>
  </style>
</resources>
