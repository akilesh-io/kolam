<?xml version="1.0" encoding="utf-8"?>
<!-- Describes Kolam to Android. Used by xmake (android.native_app in xmake.lua) to make the .apk.
     package: the app's unique name on phones and in app stores.
     minSdkVersion 24 = Android 7.0. lib_name "main" = the game is libmain.so. -->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
          package="com.kolam.game" android:versionCode="1" android:versionName="1.0">
  <uses-sdk android:minSdkVersion="24" android:targetSdkVersion="34"/>
  <uses-feature android:glEsVersion="0x00020000" android:required="true"/>
  <application android:label="Kolam" android:icon="@drawable/icon" android:hasCode="false" android:allowBackup="false">
    <activity android:name="android.app.NativeActivity" android:exported="true"
              android:screenOrientation="sensorLandscape"
              android:configChanges="orientation|keyboardHidden|screenSize|screenLayout"
              android:theme="@android:style/Theme.NoTitleBar.Fullscreen">
      <meta-data android:name="android.app.lib_name" android:value="main"/>
      <intent-filter>
        <action android:name="android.intent.action.MAIN"/>
        <category android:name="android.intent.category.LAUNCHER"/>
      </intent-filter>
    </activity>
  </application>
</manifest>
